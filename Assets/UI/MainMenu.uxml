<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement style="flex-grow: 1; background-color: rgb(0, 0, 0); flex-direction: row; align-self: auto; justify-content: flex-start; align-items: center;">
        <engine:VisualElement style="flex-grow: 0; background-size: 50% 70%; flex-direction: column; background-color: rgba(0, 255, 5, 0); width: 50%; height: 70%; justify-content: center; align-items: center;">
            <engine:Button text="Start Game" name="start-button" style="width: 30%; font-size: 36px;" />
            <engine:Button text="Settings" style="width: 30%; font-size: 36px;" />
            <engine:Button text="Quit" name="Button" style="width: 30%; font-size: 36px;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
