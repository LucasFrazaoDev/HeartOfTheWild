:root {
}

.DefaultBlackOverlay {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    display: flex;
    position: absolute;
    width: 100%;
    height: 100%;
    transition-duration: 2s;
    transition-timing-function: ease;
}

.DisplayBlackOverlay {
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    transition-duration: 2s;
    transition-timing-function: ease;
}
