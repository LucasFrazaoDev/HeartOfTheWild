<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="root" style="flex-grow: 0; background-size: 100% 100%; width: 50%; height: 50%; align-self: center; justify-content: flex-start; align-items: flex-start; margin-top: 300px;">
        <engine:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="AlwaysVisible" name="scrollView" style="flex-grow: 0; width: 100%; height: 80%; background-color: rgba(94, 94, 94, 0.73); background-size: 100% 80%;" />
        <engine:TextField placeholder-text="filler text" name="inputField" style="flex-grow: 0; width: 100%; font-size: 48px; height: auto;" />
    </engine:VisualElement>
</engine:UXML>
