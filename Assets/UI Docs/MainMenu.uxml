<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement style="flex-grow: 1; background-color: rgb(0, 0, 0); flex-direction: row; align-self: auto; justify-content: flex-start; align-items: center; background-image: url(&quot;project://database/Assets/Animations/Bakcground.png?fileID=2800000&amp;guid=7b419c2c3f2d7f14aaf99efbdbff38be&amp;type=3#Bakcground&quot;);">
        <engine:VisualElement style="flex-grow: 0; background-size: 50% 70%; flex-direction: column; background-color: rgba(0, 255, 5, 0); width: 50%; height: 70%; justify-content: center; align-items: center;">
            <engine:Label text="Florest Encantada" style="color: rgb(255, 255, 255); font-size: 96px; -unity-font-definition: resource(&apos;FlatSkin/Font/Roboto-MediumItalic&apos;);" />
            <engine:Button text="Start Game" name="start-button" style="width: 30%; font-size: 36px;" />
            <engine:Button text="Settings" name="settings-button" style="width: 30%; font-size: 36px;" />
            <engine:Button text="Quit" name="exit-button" style="width: 30%; font-size: 36px;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
